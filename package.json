{
  "name": "messmate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.mjs",
    "test:e2e": "next build && playwright test",
    "test:e2e:only": "playwright test",
    "check:security": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-security.mjs",
    "screenshots": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
