# ---------------------------------------------------------------------------
# MESSMATE environment variables
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser (used by the client and server).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: bypasses RLS. Used ONLY by `npm run seed`.
# Never import this into app code and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
